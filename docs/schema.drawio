      <mxCell id="c101" value="Типизированный слой данных — лабораторная №4 (lab4-types, TypeScript strict)" style="swimlane;whiteSpace=wrap;html=1;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;startSize=30;" vertex="1" parent="1"><mxGeometry x="30" y="620" width="1240" height="270" as="geometry"/></mxCell><mxCell id="c102" value="&lt;b&gt;api.ts + guards.ts&lt;/b&gt;&lt;br&gt;fetch → unknown → isDeliveryResponse&lt;br&gt;→ Result&amp;lt;DeliveryResponse&amp;gt;&lt;br&gt;&lt;i&gt;используется: Клиент&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;" vertex="1" parent="1"><mxGeometry x="280" y="665" width="260" height="90" as="geometry"/></mxCell><mxCell id="c103" value="&lt;b&gt;dto.ts&lt;/b&gt;&lt;br&gt;CreateXDto (Omit / Pick), UpdateXDto (Partial),&lt;br&gt;XResponse, UserResponse, RouteEfficiency,&lt;br&gt;Paginated&amp;lt;T&amp;gt;, Result&amp;lt;T&amp;gt;&lt;br&gt;&lt;i&gt;общий контракт Клиент ↔ Сервер&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;" vertex="1" parent="1"><mxGeometry x="560" y="665" width="300" height="100" as="geometry"/></mxCell><mxCell id="c104" value="&lt;b&gt;mappers.ts&lt;/b&gt;&lt;br&gt;toXResponse (поля явно), toRouteEfficiency,&lt;br&gt;paginate&amp;lt;T&amp;gt;&lt;br&gt;&lt;i&gt;используется: Сервер&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;" vertex="1" parent="1"><mxGeometry x="880" y="665" width="260" height="90" as="geometry"/></mxCell><mxCell id="c105" value="&lt;b&gt;models.ts&lt;/b&gt;&lt;br&gt;User, Courier, Vehicle, Route, Delivery&lt;br&gt;Role, TransportType,&lt;br&gt;DeliveryStatus, DelayReason&lt;br&gt;&lt;i&gt;соответствует таблицам БД&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=